# Neon connection string — pooled endpoint.
# Get it from the Neon console: Project → Connect → "Connection string".
# Copy this file to .env and paste it there. .env is gitignored; never commit
# the string and never paste it into a chat window.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
